# 复制为 .env 后按需修改
#
# 默认 mock：不花 token
# 接真模型：LLM_PROVIDER=openai + 填写 LLM_API_KEY，重启 uvicorn
# 详见 docs/接真实大模型.md
#
# DeepSeek 示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TRANSCRIPT_MAX_CHARS=20000
DATABASE_URL=sqlite:///./cv_helper.db
CORS_ORIGINS=*
