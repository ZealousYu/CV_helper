# 复制为 .env 后按需修改
#
# 默认 mock：不花 token
# 接真模型：LLM_PROVIDER=openai + 填写 LLM_API_KEY，重启 uvicorn
# 详见 docs/接真实大模型.md
#
# DeepSeek 示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TRANSCRIPT_MAX_CHARS=20000
DATABASE_URL=sqlite:///./cv_helper.db
CORS_ORIGINS=*

# 公网部署时建议设置访问密码（留空=不启用）
ACCESS_PASSWORD=

# 用户登录 JWT（公网务必改成随机长串）
JWT_SECRET=cv-helper-dev-secret-change-me
JWT_EXPIRE_DAYS=30
# 预置管理员（可选）。填写后启动会创建该账号，并把旧的无主数据挂到此账号
# 不填时：第一个注册的用户自动成为管理员并接收旧数据
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 豆包 / 火山引擎 TTS（语音读题）
# HTTP 单向流式（读题够用）：https://docs.volcengine.com/docs/6561/1598757
# 双向 WebSocket（实时对话才需要）：https://docs.volcengine.com/docs/6561/2532486
# 控制台：https://console.volcengine.com/speech/service/8
#
# 【推荐·新版】只填 API Key：控制台 → 豆包语音 → API Key 管理
DOUBAO_TTS_API_KEY=
#
# 【旧版】AppId + Access Token（应用详情里）
# DOUBAO_TTS_APP_ID=
# DOUBAO_TTS_ACCESS_KEY=
#
TTS_PROVIDER=auto
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_KEY=
DOUBAO_TTS_SPEAKER=zh_female_kefunvsheng_uranus_bigtts
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
